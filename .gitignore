*.xcodeproj
*.xcworkspace

# Xcode user data
xcuserdata/
*.xcuserdatad

# Build artifacts
build/
DerivedData/
*.ipa
*.dSYM.zip
*.dSYM

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Swift Package Manager
.build/
Packages/
Package.resolved

# CocoaPods (if ever used)
Pods/

# Miscellaneous
*.hmap
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
*.moved-aside

# Fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
fastlane/builds/

# Ruby/Bundler
.bundle/
vendor/bundle/
Gemfile.lock

# Flutter/Dart ephemera — regenerated by the toolchain, never source.
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
